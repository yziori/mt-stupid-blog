{
  "name": "mt-stupid-blog",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "4.4.2",
    "@astrojs/rss": "4.0.18",
    "@astrojs/sitemap": "3.7.2",
    "astro": "5.18.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.8",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "astro-eslint-parser": "1.4.0",
    "eslint-plugin-astro": "1.7.0",
    "lefthook": "1.13.6",
    "oxfmt": "0.46.0",
    "oxlint": "1.61.0",
    "typescript": "5.9.3",
    "vitest": "4.1.5",
    "wrangler": "4.85.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "sharp",
      "workerd"
    ]
  }
}
